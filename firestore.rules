rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY HELPERS
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function authEmail() { return request.auth.token.email; }

    // Auth tokens do not use custom claims in this project. Roles are stored in users/{uid}.
    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return incoming().diff(existing()).affectedKeys(); }
    // ATENÇÃO ao chamar estes dois: passe sempre `data.get('campo', null)`, e
    // nunca `data.campo`. Acessar uma chave ausente não devolve null — aborta a
    // avaliação da regra com "Property X is undefined on object", e o efeito é
    // uma negação total. O campo "opcional" vira obrigatório sem que ninguém
    // perceba, porque o erro só aparece quando alguém omite a chave.
    function optionalString(value, maxSize) {
      return value == null || (value is string && value.size() <= maxSize);
    }
    function optionalNumber(value) {
      return value == null || value is number;
    }

    function isValidUser(data) {
      return data.email is string &&
             data.role is string &&
             data.role in ['CUSTOMER', 'ADMIN', 'OPERATOR'] &&
             data.keys().hasAll(['email', 'role', 'createdAt']);
    }

    function isValidCustomerUserCreate(data) {
      return isValidUser(data) &&
             data.keys().hasOnly(['email', 'name', 'firstName', 'lastName', 'photoURL', 'role', 'createdAt', 'loyaltyPoints']) &&
             data.email == authEmail() &&
             data.role == 'CUSTOMER' &&
             data.createdAt == request.time &&
             (!('loyaltyPoints' in data) || data.loyaltyPoints == 0) &&
             optionalString(data.get('name', null), 160) &&
             optionalString(data.get('firstName', null), 80) &&
             optionalString(data.get('lastName', null), 80) &&
             optionalString(data.get('photoURL', null), 2048);
    }

    function isValidProfileSelfUpdate() {
      return changedKeys().hasOnly(['name', 'firstName', 'lastName', 'phone', 'addresses', 'photoURL']) &&
             optionalString(incoming().get('name', null), 160) &&
             optionalString(incoming().get('firstName', null), 80) &&
             optionalString(incoming().get('lastName', null), 80) &&
             optionalString(incoming().get('phone', null), 32) &&
             optionalString(incoming().get('photoURL', null), 2048);
    }

    function isValidAdminUserUpdate() {
      return changedKeys().hasOnly(['role', 'loyaltyPoints', 'name', 'firstName', 'lastName', 'phone', 'addresses', 'photoURL']) &&
             isValidUser(incoming()) &&
             optionalString(incoming().get('name', null), 160) &&
             optionalString(incoming().get('firstName', null), 80) &&
             optionalString(incoming().get('lastName', null), 80) &&
             optionalString(incoming().get('phone', null), 32) &&
             optionalString(incoming().get('photoURL', null), 2048) &&
             optionalNumber(incoming().get('loyaltyPoints', null));
    }

    function isValidTicketCreate(data) {
      return data.keys().hasOnly(['userId', 'userName', 'email', 'phone', 'subject', 'message', 'status', 'createdAt']) &&
             data.keys().hasAll(['subject', 'message', 'status', 'createdAt']) &&
             data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 160 &&
             data.message is string && data.message.size() >= 10 && data.message.size() <= 4000 &&
             data.status == 'OPEN' &&
             data.createdAt == request.time &&
             optionalString(data.get('userId', null), 128) &&
             optionalString(data.get('userName', null), 160) &&
             optionalString(data.get('email', null), 254) &&
             optionalString(data.get('phone', null), 32);
    }

    // O ID do documento É o e-mail normalizado. Isso transforma a unicidade da
    // inscrição em uma garantia do próprio Firestore: o cliente não precisa
    // consultar a coleção antes de gravar — leitura que a regra nega e que
    // quebrava a inscrição para todo visitante.
    function isValidNewsletterSignup(docId, data) {
      return data.keys().hasOnly(['email', 'createdAt']) &&
             data.keys().hasAll(['email', 'createdAt']) &&
             data.email is string &&
             data.email.size() <= 254 &&
             data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             data.email == data.email.lower() &&
             docId == data.email &&
             data.createdAt == request.time;
    }

    function isValidQuoteCreate(data) {
      return data.keys().hasOnly(['userId', 'userName', 'userEmail', 'status', 'fileName', 'materialId', 'infill', 'estimatedPrice', 'createdAt']) &&
             data.keys().hasAll(['userId', 'status', 'fileName', 'materialId', 'infill', 'createdAt']) &&
             data.userId == request.auth.uid &&
             optionalString(data.get('userName', null), 160) &&
             optionalString(data.get('userEmail', null), 254) &&
             data.status == 'PENDING' &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 120 &&
             isValidId(data.materialId) &&
             data.infill is number && data.infill >= 0 && data.infill <= 100 &&
             optionalNumber(data.get('estimatedPrice', null)) &&
             data.createdAt == request.time;
    }

    function isValidCategory(data) {
      return data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.keys().hasOnly(['name', 'slug', 'parentId', 'image', 'description', 'order', 'active', 'createdAt', 'updatedAt']) &&
             optionalString(data.get('slug', null), 80) &&
             optionalString(data.get('parentId', null), 128) &&
             optionalString(data.get('image', null), 2048) &&
             optionalString(data.get('description', null), 500) &&
             data.createdAt == request.time;
    }

    function isValidReview(data) {
      return data.productId is string && data.productId.size() <= 128 &&
             data.userId is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             optionalString(data.get('comment', null), 1000) &&
             optionalString(data.get('userName', null), 160) &&
             optionalString(data.get('userPhoto', null), 2048) &&
             data.keys().hasAll(['productId', 'userId', 'rating', 'createdAt']) &&
             data.keys().hasOnly(['productId', 'userId', 'userName', 'userPhoto', 'rating', 'comment', 'createdAt', 'updatedAt', 'hidden']);
    }

    function isValidReviewVote(data) {
      return data.reviewId is string && data.reviewId.size() <= 256 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.userId is string &&
             data.value is number && (data.value == 1 || data.value == -1) &&
             data.keys().hasAll(['reviewId', 'productId', 'userId', 'value', 'createdAt']) &&
             data.keys().hasOnly(['reviewId', 'productId', 'userId', 'value', 'createdAt']);
    }

    function isValidReviewReport(data) {
      return data.reviewId is string && data.reviewId.size() <= 256 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.reporterId is string &&
             optionalString(data.get('reason', null), 500) &&
             data.keys().hasAll(['reviewId', 'productId', 'reporterId', 'createdAt']) &&
             data.keys().hasOnly(['reviewId', 'productId', 'reporterId', 'reason', 'createdAt']);
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId) || (isSignedIn() && isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidCustomerUserCreate(incoming());
      allow update: if (isOwner(userId) && isValidProfileSelfUpdate()) ||
                    (isSignedIn() && isAdmin() && isValidAdminUserUpdate());
    }

    // PRODUCTS
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SHOWCASE
    match /showcase/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // MATERIALS
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Livro-razao do estoque. Movimentacoes sao criadas pelas operacoes
    // administrativas e nao podem ser alteradas depois de registradas.
    match /inventoryMovements/{movementId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // IMPRESSORAS — base de calculo das calculadoras. Preco de maquina, vida
    // util e custo de reposicao sao informacao operacional: somente admin.
    match /printers/{printerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // MODELOS DE PROJETO da calculadora. Guardam markups e custos internos.
    match /calculatorTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // COUPONS — código, percentual, limite de uso e validade são regra
    // comercial, não conteúdo de vitrine: leitura pública entregava a tabela
    // inteira de descontos a qualquer visitante. Quando o recurso for
    // construído, a validação do cupom acontece no servidor, dentro de
    // `orders/create`, junto do recálculo do total — nunca por consulta do
    // cliente, que exigiria reabrir esta leitura.
    match /coupons/{couponId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // REVIEWS — avaliações de produto. Leitura pública; cada usuário gerencia
    // a própria (id determinístico productId_uid → 1 por produto). Admin modera.
    match /reviews/{reviewId} {
      allow read: if true;
      // O dono cria/edita, mas nunca controla o campo `hidden` (moderação):
      // no create ele não pode existir; no update ele deve ser preservado —
      // isso impede reexibir uma avaliação ocultada apenas reenviando-a.
      // O ID determinístico é o que impõe "1 avaliação por usuário por
      // produto". Sem exigi-lo, bastava variar o ID do documento para publicar
      // avaliações ilimitadas do mesmo produto — o comentário prometia um
      // limite que a regra não cobrava.
      allow create: if isSignedIn()
                    && isValidReview(incoming())
                    && incoming().userId == request.auth.uid
                    && reviewId == incoming().productId + '_' + request.auth.uid
                    && !('hidden' in incoming());
      allow update: if isSignedIn()
                    && isValidReview(incoming())
                    && incoming().userId == request.auth.uid
                    && existing().userId == request.auth.uid
                    && incoming().get('hidden', null) == existing().get('hidden', null);
      allow update: if isAdmin(); // moderação (ocultar/reexibir)
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // VOTOS de "útil / não útil" nas avaliações. 1 por usuário por avaliação —
    // garantido pelo ID `reviewId__uid` (dois underscores), o mesmo que
    // `useReviews.ts` já grava. Sem a exigência, o mesmo usuário empilhava
    // votos variando o ID.
    match /reviewVotes/{voteId} {
      allow read: if true;
      allow create, update: if isSignedIn()
                            && isValidReviewVote(incoming())
                            && incoming().userId == request.auth.uid
                            && voteId == incoming().reviewId + '__' + request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // DENÚNCIAS de avaliações. Criadas por qualquer logado; só admin lê/modera.
    // Mesmo ID determinístico dos votos: uma denúncia por pessoa por avaliação,
    // senão um único denunciante inunda a fila de moderação.
    match /reviewReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && isValidReviewReport(incoming())
                    && incoming().reporterId == request.auth.uid
                    && reportId == incoming().reviewId + '__' + request.auth.uid;
      allow delete: if isAdmin();
    }

    // NEWSLETTER — inscrição anônima continua permitida (é um formulário
    // público), mas só na forma exata: e-mail como ID, `createdAt` carimbado
    // pelo servidor e nenhum campo extra. Sem `update`: reinscrever falha em
    // vez de sobrescrever a data da inscrição original.
    match /newsletter/{docId} {
      allow read: if isAdmin();
      allow create: if isValidNewsletterSignup(docId, incoming());
    }

    // SAVED CALCULATIONS
    // Regras separadas por operação: a antiga cláusula `write` com
    // `resource == null` permitia criar documentos com userId de terceiros
    // (allow statements são OR — a regra de create não restringia nada).
    match /savedCalculations/{docId} {
      allow read, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn()
                    && request.auth.uid == resource.data.userId
                    && incoming().userId == existing().userId;
    }

    // CUSTOMERS
    match /customers/{customerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // TICKETS — a validação de formato não limitava quem escreve: sem
    // `isSignedIn()` qualquer anônimo criava chamados em volume. Nenhum ponto
    // do cliente cria ticket hoje (o painel só lê e atualiza), então exigir
    // sessão não muda nada em uso. Um formulário de contato anônimo, se
    // entrar no roadmap, passa por endpoint com rate limit — não por
    // reabertura desta regra.
    match /tickets/{ticketId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidTicketCreate(incoming());
      allow update, delete: if isAdmin();
    }

    // FAQS
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      // Somente o banner/configuração global é público. Custos, margens e
      // depreciação da calculadora são informação operacional do admin.
      // Docs em uso: global, storefront, machine, pricing e company (a
      // identidade impressa nos documentos, editada na aba Ajustes).
      allow read: if settingId in ["global", "storefront"] || isAdmin();
      allow write: if isAdmin();
    }

    // LOGS
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // LIXEIRA TEMPORÁRIA — cópia restaurável de registros removidos no admin.
    match /trash/{trashId} {
      allow read, write: if isAdmin();
    }

    // ERROR REPORTS — criados só pelo servidor (Admin SDK ignora estas regras),
    // então o cliente nunca cria direto (evita spam). O admin lê e gerencia
    // (marcar como resolvido / excluir) pelo painel.
    match /errorReports/{reportId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ORDERS — criação SÓ via servidor (Admin SDK, que recalcula o total) ou
    // por um admin autenticado. O cliente não grava pedido direto: isso
    // fechava a manipulação de preço via localStorage.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow write: if isAdmin();
    }

    // QUOTES
    match /quotes/{quoteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && isValidQuoteCreate(incoming()));
      allow write: if isAdmin();
    }
  }
}
